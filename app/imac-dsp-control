#!/usr/bin/python3
"""GTK controller for the iMac PipeWire speaker DSP."""

import json
import subprocess

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gio, GLib, Gtk

from imac_dsp import (
    CODEC_NAMES, CONFIG_DIR, SETTINGS_FILE, load_profile, load_settings, write_dsp_config,
)


APP_ID = "local.imac.DspControl"

PRESETS = {
    "Balanced": dict(crossover=350.0, protection=45.0, woofer_gain=0.0, treble_gain=-1.0, headroom=-1.0),
    "Warm": dict(crossover=380.0, protection=45.0, woofer_gain=2.0, treble_gain=-2.0, headroom=-2.0),
    "Clear": dict(crossover=320.0, protection=50.0, woofer_gain=-1.0, treble_gain=1.0, headroom=-2.0),
    "Night": dict(crossover=400.0, protection=60.0, woofer_gain=-3.0, treble_gain=-2.0, headroom=-3.0),
}


def run(*args, check=True):
    return subprocess.run(args, check=check, text=True, capture_output=True)


def pipewire_nodes():
    try:
        data = json.loads(run("pw-dump").stdout)
    except (subprocess.SubprocessError, json.JSONDecodeError):
        return {}
    nodes = {}
    for item in data:
        props = item.get("info", {}).get("props", {})
        name = props.get("node.name")
        if name:
            nodes[name] = int(item["id"])
    return nodes


class DspWindow(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="iMac DSP Control")
        self.set_default_size(560, 680)
        self.profile = load_profile()
        self.crossover = self.profile["layout"] == "crossover-4.0"
        self.hardware_sink = self.profile["sink"]
        self.values = load_settings()
        self.scales = {}

        layout = "four speakers, DSP crossover" if self.crossover else "stereo, tweeter + woofer per side"
        codec = CODEC_NAMES.get(self.profile["codec"], self.profile["codec"])
        header = Adw.HeaderBar()
        title = Adw.WindowTitle(title="iMac DSP Control", subtitle=f"{self.profile['product']} • {codec} • {layout}")
        header.set_title_widget(title)

        page = Adw.PreferencesPage()
        page.add(self._preset_group())
        page.add(self._tuning_group())
        page.add(self._volume_group())
        page.add(self._actions_group())

        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(header)
        toolbar.set_content(page)

        self.toast_overlay = Adw.ToastOverlay(child=toolbar)
        self.set_content(self.toast_overlay)

    def _preset_group(self):
        group = Adw.PreferencesGroup(title="Sound profile")
        row = Adw.ComboRow(title="Preset", subtitle="Choose a starting point, then fine-tune below")
        model = Gtk.StringList.new(list(PRESETS))
        row.set_model(model)
        names = list(PRESETS)
        row.set_selected(names.index(self.values.get("preset")) if self.values.get("preset") in names else 0)
        row.connect("notify::selected", self._preset_changed)
        self.preset_row = row
        group.add(row)
        return group

    def _scale_row(self, key, title, subtitle, minimum, maximum, step, suffix):
        row = Adw.ActionRow(title=title, subtitle=subtitle)
        box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=10)
        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, minimum, maximum, step)
        scale.set_value(float(self.values[key]))
        scale.set_hexpand(True)
        scale.set_size_request(230, -1)
        value = Gtk.Label(width_chars=8, xalign=1)
        value.set_text(f"{scale.get_value():g} {suffix}")
        scale.connect("value-changed", self._scale_changed, key, value, suffix)
        box.append(scale)
        box.append(value)
        row.add_suffix(box)
        self.scales[key] = scale
        return row

    def _tuning_group(self):
        group = Adw.PreferencesGroup(title="DSP tuning", description="Changes take effect when Apply is pressed")
        min_protection = float(self.profile["min_protection"])
        if self.crossover:
            group.add(self._scale_row("crossover", "Crossover", "Boundary between woofers and tweeters", 250, 600, 10, "Hz"))
        group.add(self._scale_row("protection", "Woofer protection", "Removes sub-bass below this frequency",
                                  min_protection, max(80, min_protection + 40), 5, "Hz"))
        if self.crossover:
            group.add(self._scale_row("woofer_gain", "Woofer level", "Relative bass-driver level", -6, 3, 0.5, "dB"))
        else:
            group.add(self._scale_row("woofer_gain", "Bass level", "Low shelf below 150 Hz", -6, 3, 0.5, "dB"))
        group.add(self._scale_row("treble_gain", "Treble", "High shelf above 6.5 kHz", -6, 3, 0.5, "dB"))
        group.add(self._scale_row("headroom", "Headroom", "Negative values reduce clipping risk", -6, 0, 0.5, "dB"))
        return group

    def _volume_group(self):
        group = Adw.PreferencesGroup(title="Volume", description="These controls apply immediately")
        group.add(self._scale_row("dsp_volume", "DSP volume", "Volume of the virtual iMac DSP output", 0, 100, 1, "%"))
        group.add(self._scale_row("hardware_volume", "Amplifier volume", "Level sent to the physical speaker output", 0, 100, 1, "%"))
        self.scales["dsp_volume"].connect("value-changed", self._live_volume, "imac_dsp")
        self.scales["hardware_volume"].connect("value-changed", self._live_volume, self.hardware_sink)
        return group

    def _actions_group(self):
        group = Adw.PreferencesGroup(title="Actions")
        row = Adw.ActionRow(title="Apply DSP", subtitle="Save tuning and reload the audio filter")
        apply_button = Gtk.Button(label="Apply", css_classes=["suggested-action"])
        apply_button.connect("clicked", self._apply)
        row.add_suffix(apply_button)
        group.add(row)

        bypass = Adw.ActionRow(title="Output mode", subtitle="Switch without deleting the DSP configuration")
        dsp_button = Gtk.Button(label="DSP")
        raw_button = Gtk.Button(label="Direct 4.0" if self.crossover else "Direct")
        dsp_button.connect("clicked", self._select_output, "imac_dsp")
        raw_button.connect("clicked", self._select_output, self.hardware_sink)
        buttons = Gtk.Box(spacing=6)
        buttons.append(dsp_button)
        buttons.append(raw_button)
        bypass.add_suffix(buttons)
        group.add(bypass)

        test = Adw.ActionRow(title="Stereo test", subtitle="Voice test routed safely through the DSP")
        test_button = Gtk.Button(label="Test L/R")
        test_button.connect("clicked", self._test)
        test.add_suffix(test_button)
        group.add(test)
        return group

    def _scale_changed(self, scale, key, label, suffix):
        self.values[key] = scale.get_value()
        label.set_text(f"{scale.get_value():g} {suffix}")
        if key in {"crossover", "protection", "woofer_gain", "treble_gain", "headroom"}:
            self.values["preset"] = "Custom"

    def _preset_changed(self, row, _param):
        name = list(PRESETS)[row.get_selected()]
        self.values["preset"] = name
        for key, value in PRESETS[name].items():
            if key in self.scales:
                self.scales[key].set_value(value)
        self.values["preset"] = name

    def _toast(self, message):
        self.toast_overlay.add_toast(Adw.Toast(title=message, timeout=3))

    def _live_volume(self, scale, node_name):
        nodes = pipewire_nodes()
        node_id = nodes.get(node_name)
        if node_id is not None:
            run("wpctl", "set-volume", str(node_id), f"{scale.get_value() / 100:.2f}", check=False)

    def _select_output(self, _button, node_name):
        node_id = pipewire_nodes().get(node_name)
        if node_id is None:
            self._toast("Output not available")
            return
        result = run("wpctl", "set-default", str(node_id), check=False)
        self._toast("Output changed" if result.returncode == 0 else "Could not change output")

    def _apply(self, _button):
        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
        SETTINGS_FILE.write_text(json.dumps(self.values, indent=2) + "\n")
        write_dsp_config(self.values, self.profile)
        result = run("systemctl", "--user", "restart", "filter-chain.service", check=False)
        if result.returncode != 0:
            self._toast("DSP reload failed")
            return
        GLib.timeout_add(1000, self._finish_apply)
        self._toast("DSP configuration saved")

    def _finish_apply(self):
        self._select_output(None, "imac_dsp")
        self._live_volume(self.scales["dsp_volume"], "imac_dsp")
        self._live_volume(self.scales["hardware_volume"], self.hardware_sink)
        return GLib.SOURCE_REMOVE

    def _test(self, _button):
        self._select_output(None, "imac_dsp")
        subprocess.Popen(
            ["speaker-test", "-D", "pipewire", "-c", "2", "-t", "wav", "-l", "1"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )


class DspApplication(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.DEFAULT_FLAGS)

    def do_activate(self):
        window = self.props.active_window or DspWindow(self)
        window.present()


if __name__ == "__main__":
    raise SystemExit(DspApplication().run())
